{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "migrations/**/*.ts",
    "deploy/**/*.ts",
    "tests/**/*.ts",
    "frontend/**/*.ts"
  ]
}
