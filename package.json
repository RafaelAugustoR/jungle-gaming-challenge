{
  "name": "jungle-gaming-challenge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run typecheck && bun run build:frontend",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src migrations tests scripts",
    "format:check": "prettier --check src migrations tests scripts",
    "start": "bun src/bootstrap/main.ts",
    "dev": "bun --watch src/bootstrap/main.ts",
    "test": "bun test",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "test:integration": "bun scripts/test-integration.ts",
    "test:concurrency": "INTEGRATION=1 bun test tests/concurrency",
    "build:frontend": "bun scripts/build-frontend.ts",
    "test:browser": "bun run build:frontend && BROWSER=1 bun test tests/integration/console.test.ts",
    "worker:outbox": "bun src/bootstrap/outbox-publisher.ts",
    "worker:events": "bun src/bootstrap/event-consumer.ts",
    "provision:events": "bun scripts/provision-events.ts",
    "outbox:retry": "bun scripts/retry-outbox.ts",
    "worker:references": "bun src/bootstrap/reference-worker.ts",
    "worker:commands": "bun src/bootstrap/command-consumer.ts",
    "provision:commands": "bun scripts/provision-commands.ts",
    "test:recovery": "bun scripts/test-recovery.ts",
    "test:load": "bun scripts/test-load.ts",
    "test:stack": "bun test tests/stack",
    "demo:record": "bun scripts/record-demo.ts",
    "demo:voice": "bun scripts/demo/voice.ts",
    "demo:mix": "bun scripts/demo/mix.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1167.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "decimal.js": "10.6.0",
    "jose": "6.1.3",
    "keycloak-js": "26.2.2",
    "preact": "10.27.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright": "1.58.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  }
}
